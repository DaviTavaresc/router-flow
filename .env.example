# Fonte de dados: "demo" (local, dados fictícios no navegador) ou "supabase"
VITE_DATA_SOURCE=demo

# Supabase (necessário quando VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Geocodificação: "local" (centróides aproximados de bairros/cidades) ou "nominatim" (OpenStreetMap)
# Futuro: "mapbox" | "google"
VITE_GEOCODER=local
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=
